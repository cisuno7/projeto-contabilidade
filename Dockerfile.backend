# Dockerfile para build SÓ do backend (sem front).
# Para deploy com React atualizado no mesmo serviço, use o Dockerfile na RAIZ do repo
# (ele faz build do frontend + copia para src/main/resources/static).
#
# Use este arquivo apenas se o Root Directory do Render apontar somente para backend/
# e o front for hospedado em outro lugar (ex.: Netlify) com build próprio.
# Stage 1: build JAR com Maven
FROM maven:3.9-eclipse-temurin-17-alpine AS builder
WORKDIR /build

COPY backend/pom.xml .
COPY backend/src ./src
RUN mvn package -DskipTests -B

# Stage 2: runtime
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
